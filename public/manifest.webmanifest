{
  "name": "Baradero Local",
  "short_name": "Baradero Local",
  "description": "Comercio de proximidad para Baradero, Argentina — comprá en los negocios de tu barrio.",
  "start_url": "/pages/home.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f7fa",
  "theme_color": "#284175",
  "lang": "es-AR",
  "related_applications": [
    { "platform": "webapp", "url": "/manifest.webmanifest" }
  ],
  "shortcuts": [
    {
      "name": "Farmacias de turno",
      "short_name": "Farmacias",
      "description": "La farmacia de turno de hoy en Baradero",
      "url": "/pages/farmacias.html",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Emergencias",
      "short_name": "Emergencias",
      "description": "Policía, bomberos, hospital y ambulancia",
      "url": "/pages/servicios.html",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
